# Enterprise CyberGuard X Configuration
PROJECT_NAME="Enterprise CyberGuard X"
APP_ENV=dev
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Production must set both APP_ENV=production and a non-empty SECRET_KEY.
ACCESS_TOKEN_MINUTES=60
# PBKDF2-HMAC-SHA256 iteration count for new hashes and upgrades (minimum 600000).
PASSWORD_PBKDF2_ITERATIONS=600000
# Optional one-time first-admin bootstrap. Ignored if any analyst account already exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required by docker-compose.yml (use URL-safe hex for PostgreSQL URL compatibility).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# Database configuration: defaults to SQLite for immediate local dev, or PostgreSQL
DATABASE_URL=sqlite:///./cyberguardx.db
# In Docker, docker-compose.yml builds DATABASE_URL from POSTGRES_PASSWORD.

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# RAG & LLM Configuration (Pluggable: template_fallback, openai, groq)
LLM_PROVIDER=template_fallback
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_BACKEND=auto
RAG_MIN_RETRIEVAL_SCORE=0.25

# Optional human-reviewed agent investigation (disabled by default).
AGENT_ENABLED=false
AGENT_TOOL_MODE=native
# Blank agent LLM values inherit the corresponding LLM_* settings.
AGENT_LLM_API_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_WALL_SECONDS=90
AGENT_RESULT_CHARS=6000
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_EXECUTION_MODE=dry_run
AGENT_ALLOW_SELF_APPROVAL=false
AGENT_PROPOSAL_TTL_HOURS=24

# Random Seed & Paths
RANDOM_SEED=42
MODEL_BUNDLE_PATH=saved_models/cicids2017_medium_lightgbm.bundle.pkl
SAVED_MODELS_DIR=saved_models
DATASETS_DIR=datasets

# Correlation thresholds are demo values, not calibrated.
MITRE_MIN_PROBABILITY=0.7
RISK_HIGH_THRESHOLD=60.0
RISK_CRITICAL_THRESHOLD=80.0
RISK_ANOMALY_WEIGHT=0.5
RISK_CONFIDENCE_WEIGHT=0.3
RISK_VERDICT_WEIGHT=0.2
CORRELATION_WINDOW_MINUTES=60
FAILED_LOGIN_BURST_COUNT=5
FAILED_LOGIN_BURST_WINDOW_MINUTES=10
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
RARE_OUTBOUND_PORTS=[4444,1337,31337]
LARGE_TRANSFER_BYTES=104857600
CORRELATION_MIN_INDICATORS=3
CORRELATION_MIN_LAYERS=2
CORRELATION_INDICATOR_WEIGHT=0.6
CORRELATION_LAYER_WEIGHT=0.4
MAX_UPLOAD_SIZE_MB=50
INCIDENT_WINDOW_MINUTES=5
RAG_CHUNK_WORDS=250
RAG_CHUNK_OVERLAP_WORDS=40


