# Local secrets and environment files; Compose reads the project .env separately.
.env
.env.*
**/.env
**/.env.*

# Git metadata
.git
**/.git

# Python bytecode and local environments
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
.venv/
venv/

# Test and tool caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.tox/
**/.tox/
.nox/
**/.nox/
.hypothesis/
**/.hypothesis/
.coverage
.coverage.*

# Local database files and SQLite journals/sidecars
*.db
**/*.db
*.db-wal
**/*.db-wal
*.db-shm
**/*.db-shm
*.db-journal
**/*.db-journal
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
*.sqlite-*
**/*.sqlite-*

# Database dumps and backup directories
*.dump
**/*.dump
*.pgdump
**/*.pgdump
*.backup
**/*.backup
*.bak
**/*.bak
*.sql.gz
**/*.sql.gz
*.sql.xz
**/*.sql.xz
*.sql.zst
**/*.sql.zst
**/backup/
**/backups/
**/database_backup/
**/database_backups/
**/*backup*.sql
**/*dump*.sql
**/*backup*.zip
**/*dump*.zip
**/*backup*.tar
**/*dump*.tar
**/*backup*.tar.*
**/*dump*.tar.*
**/*backup*.7z
**/*dump*.7z
**/*backup*.rar
**/*dump*.rar

# Plain SQL dumps are excluded while SQL migration sources remain eligible.
**/*.sql
!backend/alembic/versions/*.sql
!backend/alembic/versions/**/*.sql
!backend/migrations/*.sql
!backend/migrations/**/*.sql
!**/migrations/**/*.sql
!**/alembic/versions/**/*.sql

# Local logs and temporary files
*.log
**/*.log
*.log.*
**/*.log.*
*.tmp
**/*.tmp
*.temp
**/*.temp
*.swp
**/*.swp
*.swo
**/*.swo
